{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": ".",
    "outDir": "dist",
    "esModuleInterop": true,
    "strict": true,
    "sourceMap": true,
    "types": ["node"],
    "skipLibCheck": true

  },
  "include": ["step-definitions/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}

